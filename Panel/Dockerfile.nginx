# Build stage
FROM node:24-alpine AS builder

WORKDIR /app

# Install pnpm
RUN corepack enable && corepack prepare pnpm@latest --activate

# Copy package files
COPY package.json pnpm-lock.yaml ./

# Install dependencies
RUN pnpm install --frozen-lockfile

# Copy source code
COPY . .

# Build the application (produces static files in build/ directory)
RUN pnpm build

# Production stage with Nginx
FROM nginx:1.25-alpine

# Remove default nginx config
RUN rm /etc/nginx/conf.d/default.conf

# Copy nginx config (will be added via docker-compose volume mount)
# The config at /etc/nginx/conf.d/default.conf is mounted from ./nginx/nginx.conf

# Copy built files from builder stage
COPY --from=builder /app/build /usr/share/nginx/html/admin

# Expose port
EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
